# ==============================================================================
# Research Merge Orchestrator — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your variables, or export them
# directly as system environment variables.

# Google / Gemini API Key
GOOGLE_API_KEY=""  

# Model Configuration
# Default sub-agent and validation model: Gemini 3.5 Flash Lite
MODEL_NAME="gemini-3.5-flash-lite"
# Long-context window model (LCW) for synthesis: Gemini 3.6 Flash
MODEL_LCW_NAME="gemini-3.6-flash"

# Application Context Settings
APP_NAME="research_merge_orchestrator_app"
DEFAULT_USER_ID="user_1"

# Max search results for a single agent
SEARCH_MAX_RESULTS=8
# Download timeout of a single article (e.g 8-10 sec.)
SEARCH_TIMEOUT=8

# Target Search Domains
DOMAIN_1="deeplearning.ai/the-batch"
DOMAIN_2="techcrunch.com"
DOMAIN_3="arstechnica.com/ai"

# Langfuse Telemetry Configuration
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="https://cloud.langfuse.com"
